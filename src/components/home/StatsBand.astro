---
import page from '../../data/pages/home.json';
const stats=page.stats;
---
<section class="credentials">
  <img class="stats-brush stats-brush-orange" src="/assets/graphics/stats-brush-orange.png" alt="" aria-hidden="true" />
  <div class="credentials-panel-wrap"><div class="credentials-grid">
    {stats.map((stat,index) => (
      <article class="credential">
        <div class:list={["icon",["orange","green","blue","gold","teal"][index]]}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            {index===0 && <><path d="M14 4h4l-2 7h-4z" /><path d="M10 11h5l-5 9H6z" /></>}
            {index===1 && <><path d="M12 3 20 6v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z" /><path d="m8.5 12 2.1 2.1 5-5" /></>}
            {index===2 && <><path d="M12 3 3 8h18z" /><path d="M5 9v9M9 9v9M15 9v9M19 9v9" /><path d="M3 18h18M2 21h20" /></>}
            {index===3 && <><circle cx="8" cy="8" r="3" /><circle cx="16" cy="8" r="3" /><path d="M2 20v-2c0-3 2-5 6-5s6 2 6 5v2" /><path d="M14 13c5 0 8 2 8 5v2" /></>}
            {index===4 && <><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16.5 9" /></>}
          </svg>
        </div>
        {index===4 ? <strong class="qualification">{stat.value}</strong> : <strong class="value">{stat.value}</strong>}
        {stat.label && <span class="label">{stat.label}</span>}
        <p>{stat.description}</p>
      </article>
    ))}
  </div></div>
  <img class="stats-brush stats-brush-teal" src="/assets/graphics/stats-brush-teal.png" alt="" aria-hidden="true" />
</section>
<style>
  .credentials {
    position: relative;
    background: var(--cream);
    padding: 20px 0 24px;
    overflow: hidden;
  }

  .credentials-panel-wrap {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 150px), 1680px);
    margin: 0 auto;
  }

  .credentials-grid {
    min-height: 225px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    background: rgba(255,255,255,.58);
    border: 1px solid rgba(17,42,53,.08);
    box-shadow: 0 14px 32px rgba(17,42,53,.05);
  }

  .credential {
    min-width: 0;
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-right: 1px solid rgba(17,42,53,.14);
  }

  .credential:last-child { border-right: 0; }

  .icon { margin-bottom: 9px; }

  .icon svg {
    width: 38px;
    height: 38px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .orange { color: var(--orange); }
  .green { color: var(--green); }
  .blue { color: var(--blue); }
  .gold { color: var(--gold); }
  .teal { color: var(--teal); }

  .value {
    font-family: var(--display);
    font-size: 50px;
    font-weight: 600;
    line-height: 1;
  }

  .qualification {
    margin-top: 4px;
    font-family: var(--display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.18;
    text-transform: uppercase;
  }

  .label {
    margin-top: 11px;
    font-family: var(--utility);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .credential p {
    max-width: 190px;
    margin: 9px auto 0;
    color: var(--body);
    font-size: 14px;
    line-height: 1.45;
  }

  .stats-brush {
    position: absolute;
    z-index: 3;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  .stats-brush-orange {
    width: 185px;
    left: 0;
    top: 8px;
    transform: translateX(-12%);
  }

  .stats-brush-teal {
    width: 175px;
    right: 0;
    bottom: 6px;
    transform: translateX(28%);
  }

  @media (max-width: 1050px) {
    .credentials-panel-wrap {
      width: min(calc(100% - 72px), 1680px);
    }

    .credentials-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .credential {
      border-bottom: 1px solid rgba(17,42,53,.12);
    }

    .stats-brush-orange { width: 135px; }
    .stats-brush-teal { width: 130px; }
  }

  @media (max-width: 650px) {
    .credentials-grid {
      grid-template-columns: 1fr;
    }

    .credential {
      border-right: 0;
    }

    .stats-brush {
      display: none;
    }
  }
</style>
