---
import { getCollection } from 'astro:content';
import page from '../../data/pages/home.json';
const section=page.servicesSection;

const services = (await getCollection('services'))
  .filter((service) => service.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 4);

const sectionImage =
  services.find((service) => service.data.heroImage)?.data.heroImage
  || "/images/hero/hero-02.jpg";
---

<section class="services" id="services">
  <div class="services-inner">
    <div class="services-photo">
      <img src={sectionImage} alt="" loading="lazy" />
      <div class="services-photo-shade"></div>

      <div class="services-photo-label">
        <span>{section.photoLabel}</span>
        <strong>{section.photoTitle}</strong>
      </div>
    </div>

    <div class="services-content">
      <div class="services-heading">
        <p class="eyebrow services-eyebrow">{section.eyebrow}</p>

        <h2>{section.heading}</h2>

        <p class="services-intro">{section.intro}</p>
      </div>

      <div class="service-list">
        {services.map((service, index) => {
          const number = String(index + 1).padStart(2, "0");

          return (
            <a class="service-row" href={`/services/${service.id}`}>
              <span class="service-number">{number}</span>

              <div class="service-main">
                <h3>{service.data.title}</h3>
                <p>{service.data.shortDescription}</p>
              </div>

              <span class="service-arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--navy);
    color: white;
    padding: 96px 0 104px;
  }

  .services-inner {
    width: min(calc(100% - 120px), 1500px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(420px, .9fr) minmax(620px, 1.1fr);
    gap: 72px;
    align-items: stretch;
  }

  .services-photo {
    position: relative;
    min-height: 640px;
    overflow: hidden;
  }

  .services-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 64%;
    display: block;
  }

  .services-photo-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5,42,55,.05) 38%, rgba(5,42,55,.74) 100%);
  }

  .services-photo-label {
    position: absolute;
    left: 30px;
    right: 30px;
    bottom: 28px;
    z-index: 2;
  }

  .services-photo-label span,
  .services-photo-label strong {
    display: block;
  }

  .services-photo-label span {
    color: var(--gold);
    font-family: var(--utility);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .services-photo-label strong {
    margin-top: 6px;
    color: white;
    font-family: var(--display);
    font-size: 29px;
    font-weight: 600;
    line-height: 1.1;
  }

  .services-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 34px;
  }

  .services-heading {
    max-width: 690px;
    margin-bottom: 30px;
  }

  .services-eyebrow {
    color: var(--gold);
    margin: 0 0 15px;
  }

  h2 {
    margin: 0;
    color: white;
    font-family: var(--display);
    font-size: clamp(44px, 3.55vw, 62px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -.035em;
  }

  .services-intro {
    max-width: 610px;
    margin: 24px 0 0;
    color: rgba(255,255,255,.78);
    font-size: 16px;
    line-height: 1.66;
  }

  .service-list {
    border-top: 1px solid rgba(255,255,255,.20);
  }

  .service-row {
    min-height: 105px;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 30px;
    gap: 18px;
    align-items: center;
    padding: 18px 2px;
    border-bottom: 1px solid rgba(255,255,255,.20);
    color: white;
    text-decoration: none;
    transition:
      padding-left .2s ease,
      background-color .2s ease;
  }

  .service-row:hover {
    padding-left: 12px;
    background: rgba(255,255,255,.035);
  }

  .service-number {
    color: var(--gold);
    font-family: var(--utility);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
    align-self: start;
    padding-top: 5px;
  }

  .service-main {
    min-width: 0;
  }

  h3 {
    margin: 0;
    color: white;
    font-family: var(--display);
    font-size: clamp(26px, 1.8vw, 33px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -.02em;
  }

  .service-main p {
    max-width: 620px;
    margin: 7px 0 0;
    color: rgba(255,255,255,.67);
    font-size: 14px;
    line-height: 1.5;
  }

  .service-arrow {
    color: var(--orange);
    font-size: 22px;
    justify-self: end;
    transition: transform .2s ease;
  }

  .service-row:hover .service-arrow {
    transform: translateX(5px);
  }

  @media (max-width: 1100px) {
    .services-inner {
      grid-template-columns: 1fr 1.1fr;
      gap: 44px;
    }

    .services-photo {
      min-height: 590px;
    }

    .services-content {
      padding-left: 16px;
    }
  }

  @media (max-width: 900px) {
    .services {
      padding: 76px 0 84px;
    }

    .services-inner {
      width: min(calc(100% - 48px), 1500px);
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .services-photo {
      min-height: 440px;
    }

    .services-content {
      justify-content: flex-start;
      padding-left: 0;
    }
  }

  @media (max-width: 560px) {
    .services-photo {
      min-height: 340px;
    }

    .service-row {
      grid-template-columns: 34px minmax(0,1fr) 24px;
      gap: 12px;
    }
  }
</style>
