---
import InteriorHero from './InteriorHero.astro';
const { eyebrow, title, intro, image, sections = [], imagePosition='center', backgroundColor, overlayColor, overlayOpacity, headingColor, introColor, accentColor, headingFont } = Astro.props;
---
<InteriorHero eyebrow={eyebrow} title={title} intro={intro} image={image} imagePosition={imagePosition} backgroundColor={backgroundColor} overlayColor={overlayColor} overlayOpacity={overlayOpacity} headingColor={headingColor} introColor={introColor} accentColor={accentColor} headingFont={headingFont} />

{sections.length > 0 && (
  <section class="company-body">
    <div class="company-inner">
      {sections.map((section, index) => (
        <article class="company-section">
          <span class="company-index">{String(index + 1).padStart(2,'0')}</span>
          <div>
            <h2>{section.title}</h2>
            <p>{section.copy}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .company-body{background:var(--paper);padding:76px 0 96px}
  .company-inner{width:min(calc(100% - 120px),1200px);margin:0 auto;border-top:1px solid var(--line)}
  .company-section{display:grid;grid-template-columns:70px 1fr;gap:28px;padding:38px 0;border-bottom:1px solid var(--line)}
  .company-index{color:var(--orange);font-family:var(--utility);font-size:12px;font-weight:700;letter-spacing:.1em}
  .company-section h2{margin:0;color:var(--ink);font-family:var(--display);font-size:clamp(34px,3vw,48px);font-weight:600;line-height:1.04}
  .company-section p{max-width:820px;margin:14px 0 0;color:var(--body);font-size:17px;line-height:1.72}
  @media(max-width:800px){.company-inner{width:min(calc(100% - 48px),1200px)}.company-section{grid-template-columns:1fr;gap:10px}}
</style>
