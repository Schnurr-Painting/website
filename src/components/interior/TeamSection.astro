---
import { getCollection } from 'astro:content';

const members = (await getCollection('team'))
  .filter((member) => member.data.publicProfile)
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder);
---

{members.length > 0 && (
  <section class="team-section">
    <div class="team-inner">
      <div class="team-heading">
        <p class="eyebrow">Our Team</p>
        <h2>People accountable for the work.</h2>
      </div>

      <div class="team-grid">
        {members.map((member) => (
          <article class="team-card">
            {member.data.headshot && (
              <div class="team-photo">
                <img src={member.data.headshot} alt={member.data.name} loading="lazy" />
              </div>
            )}
            <div class="team-copy">
              <p class="team-role">{member.data.role}</p>
              <h3>{member.data.name}</h3>
              {member.data.bio && <p class="team-bio">{member.data.bio}</p>}
              {(member.data.email || member.data.phone) && (
                <div class="team-contact">
                  {member.data.email && <a href={`mailto:${member.data.email}`}>{member.data.email}</a>}
                  {member.data.phone && <a href={`tel:${member.data.phone}`}>{member.data.phone}</a>}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .team-section{background:var(--cream);padding:78px 0 96px}
  .team-inner{width:min(calc(100% - 120px),1200px);margin:0 auto}
  .team-heading{max-width:720px;margin-bottom:34px}
  .team-heading .eyebrow{margin:0 0 10px;color:var(--gold)}
  .team-heading h2{margin:0;color:var(--ink);font-family:var(--display);font-size:clamp(38px,3.3vw,54px);font-weight:600;line-height:1.04}
  .team-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
  .team-card{background:var(--paper);border-top:4px solid var(--gold)}
  .team-photo{aspect-ratio:4/3;overflow:hidden;background:#e9e3d8}
  .team-photo img{width:100%;height:100%;object-fit:cover;display:block}
  .team-copy{padding:26px 28px 30px}
  .team-role{margin:0;color:var(--gold);font-family:var(--utility);font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .team-copy h3{margin:7px 0 0;color:var(--ink);font-family:var(--display);font-size:30px;font-weight:600}
  .team-bio{margin:14px 0 0;color:var(--body);font-size:15px;line-height:1.62}
  .team-contact{display:flex;flex-direction:column;gap:6px;margin-top:18px}
  .team-contact a{color:var(--ink);font-size:14px}
  @media(max-width:900px){.team-inner{width:min(calc(100% - 48px),1200px)}.team-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:620px){.team-grid{grid-template-columns:1fr}}
</style>
