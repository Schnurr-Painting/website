---
---

<div class="application-modal" id="application-modal" aria-hidden="true">
  <div class="application-modal-backdrop" data-close-app-modal></div>

  <div class="application-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="application-modal-heading">
    <button type="button" class="application-modal-close" data-close-app-modal aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>

    <div class="application-modal-heading" id="application-heading-block">
      <p class="eyebrow">General Application</p>
      <h2 id="application-modal-heading">Interested in Joining the Crew?</h2>
      <p class="application-modal-intro">Send us your info and we'll follow up if it's a fit.</p>
    </div>

    <form
      name="job-application"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      enctype="multipart/form-data"
      class="application-form"
      id="application-form"
    >
      <input type="hidden" name="form-name" value="job-application" />
      <input type="hidden" name="appliedForPosition" id="app-applied-for" value="" />
      <p class="hidden-field"><label>Don't fill this out: <input name="bot-field" /></label></p>

      <div class="field-row">
        <div class="field">
          <label for="app-name">Name *</label>
          <input type="text" id="app-name" name="name" required />
        </div>
        <div class="field">
          <label for="app-email">Email *</label>
          <input type="email" id="app-email" name="email" required />
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="app-phone">Phone *</label>
          <input type="tel" id="app-phone" name="phone" required />
        </div>
        <div class="field">
          <label for="app-role">Role Interested In</label>
          <select id="app-role" name="roleInterest">
            <option value="">Select one</option>
            <option>Crew Painter</option>
            <option>Foreman / Crew Lead</option>
            <option>Apprentice</option>
            <option>Estimator</option>
            <option>Project Manager</option>
            <option>Not Sure Yet</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="app-experience">Experience</label>
        <input type="text" id="app-experience" name="experience" placeholder="Years in the trade, relevant certifications, past employers&mdash;whatever's relevant." />
      </div>

      <div class="field">
        <label for="app-resume">Resume</label>
        <input type="file" id="app-resume" name="resume" accept=".pdf,.doc,.docx" />
      </div>

      <div class="field">
        <label for="app-message">Anything Else</label>
        <textarea id="app-message" name="message" rows="3"></textarea>
      </div>

      <button type="submit" class="btn btn-primary submit-btn">Submit Application <span aria-hidden="true">→</span></button>

      <p class="form-status" id="app-status" role="status" aria-live="polite"></p>
    </form>

    <div class="application-success" id="application-success" hidden>
      <div class="success-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 12l5 5L20 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
      </div>
      <h2>Application Received</h2>
      <p>Thanks for your interest &mdash; we'll review your application and reach out if it's a fit.</p>
      <button type="button" class="btn btn-outline-light success-close" data-close-app-modal>Close</button>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('application-modal');
  const form = document.getElementById('application-form');
  const status = document.getElementById('app-status');
  const headingBlock = document.getElementById('application-heading-block');
  const headingText = document.getElementById('application-modal-heading');
  const successView = document.getElementById('application-success');
  const roleSelect = document.getElementById('app-role');
  const appliedForField = document.getElementById('app-applied-for');
  let lastFocused = null;

  function resetToFormView() {
    headingBlock.hidden = false;
    successView.hidden = true;
    form.style.display = '';
    form.reset();
    status.textContent = '';
    status.classList.remove('error');
    const submitBtn = form.querySelector('.submit-btn');
    submitBtn.disabled = false;
  }

  function openModal(positionTitle, roleType) {
    lastFocused = document.activeElement;
    resetToFormView();

    if (positionTitle) {
      headingText.textContent = `Apply: ${positionTitle}`;
      appliedForField.value = positionTitle;
      if (roleType && Array.from(roleSelect.options).some(o => o.value === roleType)) {
        roleSelect.value = roleType;
      }
    } else {
      headingText.textContent = 'Interested in Joining the Crew?';
      appliedForField.value = '';
    }

    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    document.getElementById('app-name')?.focus();
  }

  function closeModal() {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  // Any element anywhere on the page with data-open-application triggers this
  // modal. data-position-title / data-role-type (if present) pre-fill it for
  // a specific posting; omit both for a general application.
  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('[data-open-application]');
    if (trigger) {
      e.preventDefault();
      openModal(trigger.dataset.positionTitle, trigger.dataset.roleType);
      return;
    }
    if (e.target.closest('[data-close-app-modal]')) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('open')) {
      closeModal();
    }
    if (e.key === 'Tab' && modal.classList.contains('open')) {
      const focusable = modal.querySelectorAll('input, select, textarea, button, a[href]');
      const visible = Array.from(focusable).filter(el => el.offsetParent !== null);
      const first = visible[0];
      const last = visible[visible.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    // Raw FormData, not URL-encoded - required for the resume file upload
    // to actually reach Netlify Forms (matches the same requirement noted
    // in the original ApplicationForm component this replaces).
    const formData = new FormData(form);

    const submitBtn = form.querySelector('.submit-btn');
    submitBtn.disabled = true;

    try {
      const response = await fetch('/', {
        method: 'POST',
        body: formData,
      });

      if (response.ok) {
        headingBlock.hidden = true;
        form.style.display = 'none';
        successView.hidden = false;
        successView.querySelector('.success-close')?.focus();
      } else {
        throw new Error('Submission failed');
      }
    } catch (err) {
      status.textContent = 'Something went wrong sending that. Please try again, or call us directly.';
      status.classList.add('error');
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .application-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
  }

  .application-modal.open {
    display: block;
  }

  .application-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(17, 10, 20, 0.6);
  }

  .application-modal-dialog {
    position: relative;
    z-index: 1;
    background: var(--paper);
    width: min(calc(100% - 40px), 640px);
    max-height: calc(100vh - 60px);
    overflow-y: auto;
    margin: 30px auto;
    padding: 40px;
  }

  .application-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .application-modal-close svg {
    width: 16px;
    height: 16px;
    color: var(--ink);
  }

  .application-modal-heading {
    margin-bottom: 24px;
    padding-right: 40px;
  }

  .application-modal-heading h2 {
    margin: 10px 0 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 600;
    line-height: 1.15;
  }

  .application-modal-intro {
    margin: 10px 0 0;
    color: var(--body);
    font-size: 15px;
    line-height: 1.6;
  }

  .application-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hidden-field {
    position: absolute;
    left: -9999px;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-family: var(--utility);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .field input,
  .field select,
  .field textarea {
    font-family: var(--body-font);
    font-size: 15px;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid var(--line);
    padding: 10px 12px;
    width: 100%;
  }

  .field input[type="file"] {
    padding: 8px 10px;
    background: var(--cream);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid var(--gold);
    outline-offset: -1px;
  }

  .field textarea {
    resize: vertical;
    font-family: inherit;
  }

  .submit-btn {
    align-self: flex-start;
    margin-top: 4px;
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-status {
    margin: 0;
    font-size: 14px;
  }

  .form-status.error {
    color: #a13a2f;
    font-weight: 600;
  }

  .application-success {
    text-align: center;
    padding: 20px 10px 8px;
  }

  .success-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: #e8f0e6;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .success-icon svg {
    width: 28px;
    height: 28px;
    color: #3d6e3d;
  }

  .application-success h2 {
    margin: 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: 26px;
    font-weight: 600;
  }

  .application-success p {
    margin: 12px 0 0;
    color: var(--body);
    font-size: 15px;
    line-height: 1.6;
  }

  .application-success .success-close {
    margin: 24px auto 0;
    color: var(--ink);
    border-color: var(--line);
  }

  @media (max-width: 600px) {
    .field-row {
      grid-template-columns: 1fr;
    }

    .application-modal-dialog {
      padding: 28px 20px;
    }
  }
</style>
