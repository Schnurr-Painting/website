---
---

<section class="application-section" id="apply">
  <div class="application-inner">
    <div class="application-heading">
      <p class="eyebrow">General Application</p>
      <h2>Interested in Joining the Crew?</h2>
      <p class="application-intro">Send us your info even if you don't see a specific opening above &mdash; we keep applications on file and reach out when the right role comes up.</p>
    </div>

    <form
      name="job-application"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      enctype="multipart/form-data"
      class="application-form"
      id="application-form"
    >
      <input type="hidden" name="form-name" value="job-application" />
      <p class="hidden-field"><label>Don't fill this out: <input name="bot-field" /></label></p>

      <div class="field-row">
        <div class="field">
          <label for="app-name">Name *</label>
          <input type="text" id="app-name" name="name" required />
        </div>
        <div class="field">
          <label for="app-email">Email *</label>
          <input type="email" id="app-email" name="email" required />
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="app-phone">Phone *</label>
          <input type="tel" id="app-phone" name="phone" required />
        </div>
        <div class="field">
          <label for="app-role">Role Interested In</label>
          <select id="app-role" name="roleInterest">
            <option value="">Select one</option>
            <option>Crew Painter</option>
            <option>Foreman / Crew Lead</option>
            <option>Apprentice</option>
            <option>Estimator</option>
            <option>Project Manager</option>
            <option>Not Sure Yet</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="app-experience">Experience</label>
        <input type="text" id="app-experience" name="experience" placeholder="Years in the trade, relevant certifications, past employers&mdash;whatever's relevant." />
      </div>

      <div class="field">
        <label for="app-resume">Resume</label>
        <input type="file" id="app-resume" name="resume" accept=".pdf,.doc,.docx" />
      </div>

      <div class="field">
        <label for="app-message">Anything Else</label>
        <textarea id="app-message" name="message" rows="3"></textarea>
      </div>

      <button type="submit" class="btn btn-primary submit-btn">Submit Application <span aria-hidden="true">→</span></button>

      <p class="form-status" id="app-status" role="status" aria-live="polite"></p>
    </form>

    <div class="application-success" id="application-success" hidden>
      <div class="success-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 12l5 5L20 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
      </div>
      <h2>Application Received</h2>
      <p>Thanks for your interest &mdash; we'll review your application and reach out if it's a fit.</p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('application-form');
  const status = document.getElementById('app-status');
  const heading = document.querySelector('.application-heading');
  const successView = document.getElementById('application-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    // Uses raw FormData (not URL-encoded) so the browser sets the correct
    // multipart boundary automatically - required for the resume file upload
    // to actually reach Netlify Forms. Do not set a Content-Type header here.
    const formData = new FormData(form);

    const submitBtn = form.querySelector('.submit-btn');
    submitBtn.disabled = true;

    try {
      const response = await fetch('/', {
        method: 'POST',
        body: formData,
      });

      if (response.ok) {
        heading.hidden = true;
        form.style.display = 'none';
        successView.hidden = false;
      } else {
        throw new Error('Submission failed');
      }
    } catch (err) {
      status.textContent = 'Something went wrong sending that. Please try again, or call us directly.';
      status.classList.add('error');
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .application-section {
    background: var(--paper);
    padding: 76px 0 96px;
  }

  .application-inner {
    width: min(calc(100% - 120px), 700px);
    margin: 0 auto;
  }

  .application-heading {
    text-align: center;
    margin-bottom: 36px;
  }

  .application-heading h2 {
    margin: 10px 0 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 600;
  }

  .application-intro {
    max-width: 480px;
    margin: 14px auto 0;
    color: var(--body);
    font-size: 15px;
    line-height: 1.6;
  }

  .application-form {
    background: var(--cream);
    border: 1px solid var(--line);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hidden-field {
    position: absolute;
    left: -9999px;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-family: var(--utility);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .field input,
  .field select,
  .field textarea {
    font-family: var(--body-font);
    font-size: 15px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 12px 14px;
    width: 100%;
  }

  .field input[type="file"] {
    padding: 10px 12px;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid var(--gold);
    outline-offset: -1px;
  }

  .field textarea {
    resize: vertical;
    font-family: inherit;
  }

  .submit-btn {
    align-self: flex-start;
    margin-top: 4px;
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-status {
    margin: 0;
    font-size: 14.5px;
  }

  .form-status.error {
    color: #a13a2f;
    font-weight: 600;
  }

  .application-success {
    text-align: center;
    background: var(--cream);
    border: 1px solid var(--line);
    padding: 48px 32px;
  }

  .success-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: #e8f0e6;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .success-icon svg {
    width: 28px;
    height: 28px;
    color: #3d6e3d;
  }

  .application-success h2 {
    margin: 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: 26px;
    font-weight: 600;
  }

  .application-success p {
    margin: 12px 0 0;
    color: var(--body);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .field-row {
      grid-template-columns: 1fr;
    }

    .application-form {
      padding: 28px 24px;
    }
  }
</style>
