---
import { getCollection, render } from 'astro:content';

let renderedPositions = [];
try {
  const positions = (await getCollection('positions'))
    .filter((p) => p.data.active)
    .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

  renderedPositions = await Promise.all(
    positions.map(async (p) => {
      const { Content } = await render(p);
      const requirementLines = (p.data.requirements || '')
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean);
      return { data: p.data, Content, requirementLines };
    })
  );
} catch {
  // A completely empty collection (zero files) throws rather than
  // returning []. Treat that the same as "no active postings."
  renderedPositions = [];
}
---

<section class="positions">
  <div class="positions-inner">
    <div class="positions-heading">
      <p class="eyebrow">Open Positions</p>
      <h2>Current Openings</h2>
    </div>

    {renderedPositions.length > 0 ? (
      <div class="positions-list">
        {renderedPositions.map((position) => (
          <article class="position-card">
            <div class="position-meta">
              <span class="position-type">{position.data.roleType}</span>
              <span class="position-employment">{position.data.employmentType}</span>
              {position.data.location && <span class="position-location">{position.data.location}</span>}
            </div>
            <h3>{position.data.title}</h3>
            <div class="position-description">
              <position.Content />
            </div>
            {position.requirementLines.length > 0 && (
              <div class="position-requirements-block">
                <p class="requirements-heading">Requirements</p>
                <ul class="position-requirements">
                  {position.requirementLines.map((req) => <li>{req}</li>)}
                </ul>
              </div>
            )}
            <button
              type="button"
              class="btn btn-primary apply-link"
              data-open-application
              data-position-title={position.data.title}
              data-role-type={position.data.roleType}
            >
              Apply for This Role <span aria-hidden="true">→</span>
            </button>
          </article>
        ))}
      </div>
    ) : (
      <div class="positions-empty">
        <p>No open positions posted right now &mdash; but we're always interested in meeting good people.</p>
        <button type="button" class="btn btn-primary" data-open-application>
          Submit a General Application <span aria-hidden="true">→</span>
        </button>
      </div>
    )}
  </div>
</section>

<style>
  .positions {
    background: var(--cream);
    padding: 76px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .positions-inner {
    width: min(calc(100% - 120px), 1000px);
    margin: 0 auto;
  }

  .positions-heading {
    text-align: center;
    margin-bottom: 40px;
  }

  .positions-heading h2 {
    margin: 10px 0 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 600;
  }

  .positions-empty {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 32px;
    text-align: center;
  }

  .positions-empty p {
    margin: 0 0 20px;
    color: var(--body);
    font-size: 16px;
    line-height: 1.6;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .positions-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .position-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 4px solid var(--orange);
    padding: 28px 32px;
  }

  .position-meta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .position-meta span {
    font-family: var(--utility);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--orange);
  }

  .position-meta .position-location {
    color: var(--body);
  }

  .position-card h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: 24px;
    font-weight: 600;
  }

  .position-description {
    margin: 10px 0 0;
    color: var(--body);
    font-size: 15.5px;
    line-height: 1.6;
    max-width: 700px;
  }

  .position-description :global(p) {
    margin: 0 0 12px;
  }

  .position-description :global(p:last-child) {
    margin-bottom: 0;
  }

  .position-description :global(ul),
  .position-description :global(ol) {
    margin: 0 0 12px;
    padding-left: 20px;
  }

  .position-description :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  .position-requirements-block {
    margin-top: 16px;
  }

  .requirements-heading {
    margin: 0 0 8px;
    font-family: var(--utility);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .position-requirements {
    margin: 0;
    padding-left: 20px;
    color: var(--body);
    font-size: 14.5px;
    line-height: 1.7;
  }

  .apply-link {
    margin-top: 18px;
  }

  @media (max-width: 700px) {
    .position-card {
      padding: 22px 20px;
    }
  }
</style>
