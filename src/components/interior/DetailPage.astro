---
import InteriorHero from './InteriorHero.astro';
import shared from '../../data/site-shared.json';
const { eyebrow, title, intro, image, details = [], backgroundColor, overlayColor, overlayOpacity, headingColor, introColor, accentColor, headingFont } = Astro.props;
---
<InteriorHero eyebrow={eyebrow} title={title} intro={intro} image={image} backgroundColor={backgroundColor} overlayColor={overlayColor} overlayOpacity={overlayOpacity} headingColor={headingColor} introColor={introColor} accentColor={accentColor} headingFont={headingFont} />
<section class="detail-body">
  <div class="detail-inner">
    <article class="detail-copy"><slot /></article>
    {details.length > 0 && (
      <aside class="detail-facts">
        {details.map((detail) => (
          <div class="detail-fact"><span>{detail.label}</span><strong>{detail.value}</strong></div>
        ))}
      </aside>
    )}
  </div>
</section>
<section class="detail-cta">
  <div class="detail-cta-inner">
    <div><p class="eyebrow">{shared.detailCtaEyebrow}</p><h2>{shared.detailCtaHeading}</h2></div>
    <a class="btn btn-primary" href="/#request-bid">Request a Bid →</a>
  </div>
</section>
<style>
  .detail-body{background:var(--paper);padding:76px 0 96px}
  .detail-inner,.detail-cta-inner{width:min(calc(100% - 120px),var(--content-max));margin:0 auto}
  .detail-inner{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:90px;align-items:start}
  .detail-copy{max-width:860px;color:var(--body);font-size:17px;line-height:1.75}
  .detail-facts{border-top:4px solid var(--orange);background:var(--cream)}
  .detail-fact{padding:22px 24px;border-bottom:1px solid var(--line)}
  .detail-fact span,.detail-fact strong{display:block}
  .detail-fact span{color:var(--body);font-family:var(--utility);font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .detail-fact strong{margin-top:5px;color:var(--ink);font-size:16px}
  .detail-cta{background:var(--navy);padding:58px 0}
  .detail-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:40px}
  .detail-cta h2{margin:6px 0 0;color:#fff;font-family:var(--display);font-size:clamp(34px,3vw,48px);font-weight:600;line-height:1.05}
  @media(max-width:900px){.detail-inner,.detail-cta-inner{width:min(calc(100% - 48px),var(--content-max))}.detail-inner{grid-template-columns:1fr;gap:44px}.detail-cta-inner{align-items:flex-start;flex-direction:column}}
</style>
