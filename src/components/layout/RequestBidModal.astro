---
import page from '../../data/pages/home.json';
const section = page.requestBidSection;
---

<div class="bid-modal" id="bid-modal" aria-hidden="true">
  <div class="bid-modal-backdrop" data-close-modal></div>

  <div class="bid-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="bid-modal-heading">
    <button type="button" class="bid-modal-close" data-close-modal aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>

    <div class="bid-modal-heading" id="bid-modal-heading-block">
      <p class="eyebrow">{section.eyebrow}</p>
      <h2 id="bid-modal-heading">{section.heading}</h2>
      <p class="bid-modal-intro">{section.intro}</p>
    </div>

    <div class="bid-modal-success" id="bid-modal-success" hidden>
      <div class="success-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 12l5 5L20 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
      </div>
      <h2>Request Sent</h2>
      <p>Thanks &mdash; we've got your request and will be in touch shortly.</p>
      <button type="button" class="btn btn-outline-light success-close" data-close-modal>Close</button>
    </div>

    <form
      name="request-bid"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="bid-modal-form"
      id="request-bid-form"
    >
      <input type="hidden" name="form-name" value="request-bid" />
      <p class="hidden-field"><label>Don't fill this out: <input name="bot-field" /></label></p>

      <div class="field-row">
        <div class="field">
          <label for="rb-name">Name *</label>
          <input type="text" id="rb-name" name="name" required />
        </div>
        <div class="field">
          <label for="rb-email">Email *</label>
          <input type="email" id="rb-email" name="email" required />
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="rb-phone">Phone</label>
          <input type="tel" id="rb-phone" name="phone" />
        </div>
        <div class="field">
          <label for="rb-company">Company</label>
          <input type="text" id="rb-company" name="company" />
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="rb-type">Project Type</label>
          <select id="rb-type" name="projectType">
            <option value="">Select one</option>
            <option>Interior Painting</option>
            <option>Exterior Painting</option>
            <option>Wallcovering & Finishes</option>
            <option>Specialty Coatings</option>
            <option>Not Sure Yet</option>
          </select>
        </div>
        <div class="field">
          <label for="rb-timeline">Timeline</label>
          <select id="rb-timeline" name="timeline">
            <option value="">Select one</option>
            <option>As Soon As Possible</option>
            <option>Within 30 Days</option>
            <option>1&ndash;3 Months</option>
            <option>Just Researching</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="rb-location">Project Location</label>
        <input type="text" id="rb-location" name="location" placeholder="City, or building address if known" />
      </div>

      <div class="field">
        <label for="rb-details">Project Details</label>
        <textarea id="rb-details" name="details" rows="3" placeholder="Scope, square footage, current condition&mdash;whatever you have."></textarea>
      </div>

      <button type="submit" class="btn btn-primary submit-btn">Send Request <span aria-hidden="true">→</span></button>

      <p class="form-status" id="rb-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</div><script>
  const modal = document.getElementById('bid-modal');
  const form = document.getElementById('request-bid-form');
  const status = document.getElementById('rb-status');
  const headingBlock = document.getElementById('bid-modal-heading-block');
  const successView = document.getElementById('bid-modal-success');
  let lastFocused = null;

  function resetToFormView() {
    headingBlock.hidden = false;
    successView.hidden = true;
    form.style.display = '';
    form.reset();
    status.textContent = '';
    status.classList.remove('success', 'error');
    const submitBtn = form.querySelector('.submit-btn');
    submitBtn.disabled = false;
  }

  function openModal() {
    lastFocused = document.activeElement;
    resetToFormView();
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    const firstInput = modal.querySelector('#rb-name');
    firstInput?.focus();
  }

  function closeModal() {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  // Intercept every existing "Request a Bid" link site-wide, wherever it lives,
  // without needing to touch Header/Hero/DetailPage/Resources markup individually.
  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('a[href$="#request-bid"]');
    if (trigger) {
      e.preventDefault();
      openModal();
      return;
    }
    if (e.target.closest('[data-close-modal]')) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('open')) {
      closeModal();
    }
    // basic focus trap
    if (e.key === 'Tab' && modal.classList.contains('open')) {
      const focusable = modal.querySelectorAll('input, select, textarea, button, a[href]');
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const body = new URLSearchParams();
    formData.forEach((value, key) => body.append(key, String(value)));

    const submitBtn = form.querySelector('.submit-btn');
    submitBtn.disabled = true;

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      });

      if (response.ok) {
        headingBlock.hidden = true;
        form.style.display = 'none';
        successView.hidden = false;
        successView.querySelector('.success-close')?.focus();
      } else {
        throw new Error('Submission failed');
      }
    } catch (err) {
      status.textContent = 'Something went wrong sending that. Please try again, or call us directly.';
      status.classList.add('error');
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .bid-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
  }

  .bid-modal.open {
    display: block;
  }

  .bid-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(17, 10, 20, 0.6);
  }

  .bid-modal-dialog {
    position: relative;
    z-index: 1;
    background: var(--paper);
    width: min(calc(100% - 40px), 640px);
    max-height: calc(100vh - 60px);
    overflow-y: auto;
    margin: 30px auto;
    padding: 40px;
  }

  .bid-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .bid-modal-close svg {
    width: 16px;
    height: 16px;
    color: var(--ink);
  }

  .bid-modal-heading {
    margin-bottom: 28px;
    padding-right: 40px;
  }

  .bid-modal-heading h2 {
    margin: 10px 0 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(26px, 3vw, 32px);
    font-weight: 600;
    line-height: 1.1;
  }

  .bid-modal-intro {
    margin: 12px 0 0;
    color: var(--body);
    font-size: 15px;
    line-height: 1.6;
  }

  .bid-modal-success {
    text-align: center;
    padding: 20px 10px 8px;
  }

  .success-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: #e8f0e6;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .success-icon svg {
    width: 28px;
    height: 28px;
    color: #3d6e3d;
  }

  .bid-modal-success h2 {
    margin: 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: 26px;
    font-weight: 600;
  }

  .bid-modal-success p {
    margin: 12px 0 0;
    color: var(--body);
    font-size: 15px;
    line-height: 1.6;
  }

  .bid-modal-success .success-close {
    margin: 24px auto 0;
    color: var(--ink);
    border-color: var(--line);
  }

  .bid-modal-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hidden-field {
    position: absolute;
    left: -9999px;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-family: var(--utility);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .field input,
  .field select,
  .field textarea {
    font-family: var(--body-font);
    font-size: 15px;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid var(--line);
    padding: 10px 12px;
    width: 100%;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid var(--gold);
    outline-offset: -1px;
  }

  .field textarea {
    resize: vertical;
    font-family: inherit;
  }

  .submit-btn {
    align-self: flex-start;
    margin-top: 4px;
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-status {
    margin: 0;
    font-size: 14px;
  }

  .form-status.success {
    color: #3d6e3d;
    font-weight: 600;
  }

  .form-status.error {
    color: #a13a2f;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .field-row {
      grid-template-columns: 1fr;
    }

    .bid-modal-dialog {
      padding: 28px 20px;
    }
  }
</style>
