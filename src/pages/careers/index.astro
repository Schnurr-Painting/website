---
import SitePage from '../../layouts/SitePage.astro';
import CompanyPage from '../../components/interior/CompanyPage.astro';
import PositionsList from '../../components/interior/PositionsList.astro';
import ApplicationModal from '../../components/interior/ApplicationModal.astro';
import page from '../../data/pages/careers.json';
const h = page.hero;
---
<SitePage title={page.title} description={page.seoDescription}>
  <CompanyPage
    eyebrow={h.eyebrow}
    title={h.title}
    intro={h.intro}
    image={h.image || undefined}
    imagePosition={h.imagePosition}
    backgroundColor={h.backgroundColor}
    overlayColor={h.overlayColor}
    overlayOpacity={h.overlayOpacity}
    headingColor={h.headingColor}
    introColor={h.introColor}
    accentColor={h.accentColor}
    headingFont={h.headingFont}
  />
  <PositionsList />
  <ApplicationModal />
</SitePage>
