---
import '../styles/global.css';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/home/Hero.astro';
import StatsBand from '../components/home/StatsBand.astro';
import Services from '../components/home/Services.astro';
import Markets from '../components/home/Markets.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      name="description"
      content="Schnurr Painting provides commercial painting, coatings, wallcovering and specialty finish services."
    />

    <title>Schnurr Painting</title>

    <!-- Required for Netlify Identity invite/recovery/confirmation links to work.
         These always redirect to the site root with a token in the URL hash;
         without this script present, the token is silently ignored. -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" is:inline></script>
  </head>

  <body>
    <Header />

    <main>
      <Hero />
      <StatsBand />
      <Services />
      <Markets />
      <FeaturedProjects />
    </main>

    <Footer />
  </body>
</html>
