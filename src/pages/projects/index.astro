---
import { getCollection } from 'astro:content';
import SitePage from '../../layouts/SitePage.astro';
import InteriorHero from '../../components/interior/InteriorHero.astro';
import CollectionGrid from '../../components/interior/CollectionGrid.astro';
import TestimonialsBand from '../../components/interior/TestimonialsBand.astro';
import page from '../../data/pages/projects.json';
const projects=(await getCollection('projects')).sort((a,b)=>a.data.sortOrder-b.data.sortOrder);
const items=projects.map(project=>({id:project.id,title:project.data.title,description:project.data.shortDescription,meta:project.data.market,image:project.data.featuredImage,href:`/projects/${project.id.replace(/\.md$/,'')}`}));
const h=page.hero;
---
<SitePage title={page.title} description={page.seoDescription}>
  <InteriorHero eyebrow={h.eyebrow} title={h.title} intro={h.intro} image={h.image} imagePosition={h.imagePosition} backgroundColor={h.backgroundColor} overlayColor={h.overlayColor} overlayOpacity={h.overlayOpacity} headingColor={h.headingColor} introColor={h.introColor} accentColor={h.accentColor} headingFont={h.headingFont} />
  <CollectionGrid items={items} />
  <TestimonialsBand page="projects" />
</SitePage>
